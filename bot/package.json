{
  "name": "@oracle/bot",
  "version": "1.0.0",
  "description": "An all-in-one discord bot",
  "homepage": "https://github.com/emanueletocci/oracle#readme",
  "bugs": {
    "url": "https://github.com/emanueletocci/oracle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emanueletocci/oracle.git"
  },
  "license": "ISC",
  "author": "emanuele tocci",
  "type": "module",
  "main": "src/index.js",
  "imports": {
    "#config": "./config.json",
    "#commands/*": "./src/commands/*",
    "#data/*": "./src/data/*",
    "#database/*": "./src/database/*",
    "#events/*": "./src/events/*",
    "#settings/*": "./src/settings/*",
    "#themes/*": "./src/themes/*",
    "#utils/*": "./src/utils/*"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/scripts/deploy-commands.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@distube/direct-link": "^1.0.1",
    "@distube/youtube": "^1.1.0",
    "@distube/yt-dlp": "^2.0.1",
    "@distube/ytdl-core": "^5.2.1",
    "@napi-rs/canvas": "^0.1.88",
    "better-sqlite3": "^13.2.0",
    "discord.js": "^14.28.1",
    "distube": "^5.2.3",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.7.16",
    "opusscript": "^0.0.8",
    "undici": "^8.2.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "vitest": "^5.1.1"
  }
}
